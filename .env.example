# Copia este fichero como .env.local (no se sube a git) y rellena la clave.
# La usa solo el servidor local (npm run dev / npm run preview); nunca llega al navegador.

# Clave de la API de Gemini (Google AI Studio).
GEMINI_API_KEY=

# Modelo (opcional). Por defecto gemini-3.6-flash. Los identificadores vigentes están en
# https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.6-flash

# Registro de decisiones en Google Sheets (opcional). Ver README, apartado «Registro en Google Sheets».
# URL de la aplicación web de Apps Script (termina en /exec) y el secreto que pusiste en el script.
# SHEETS_WEBHOOK_URL=
# SHEETS_SECRET=

# Registro de decisiones en PostgreSQL (opcional). `npm run db:up` levanta un contenedor propio (docker-compose.yml)
# con la contraseña de BREWFACTORY_DB_PASSWORD; la URL usa esa misma contraseña. Ver README.
# BREWFACTORY_DB_PASSWORD=
# BREWFACTORY_DATABASE_URL=postgres://brewfactory:<contraseña>@localhost:5433/brewfactory
