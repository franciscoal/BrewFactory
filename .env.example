# Copia este fichero como .env.local (no se sube a git) y rellena la clave.
# La usa solo el servidor local (npm run dev / npm run preview); nunca llega al navegador.

# Clave de la API de Gemini (Google AI Studio).
GEMINI_API_KEY=

# Modelo (opcional). Por defecto gemini-3.6-flash. Los identificadores vigentes están en
# https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.6-flash
